{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIED",
  "version": "0.1.0",
  "identifier": "br.sied.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SIED — Sistema Integrado de Evidências Digitais",
        "decorations": false,
        "backgroundColor": "#07090e",
        "width": 1020,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$HOME/**", "$APPDATA/**", "$RESOURCE/**"] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["licenses/lopdf-0.45.0.txt"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  },
  "plugins": {}
}
